# Inject a distinct API key of at least 32 characters and an existing authorized HF token at runtime.
VLLM_API_KEY=changeme
HF_TOKEN=changeme
APERTUS_MODEL_ID=swiss-ai/Apertus-v1.5-8B
APERTUS_MODEL_REVISION=ef4bbc54d6fe658bc782280ff9f3b53a10a9758f
APERTUS_SERVED_MODEL=apertus-v1-5-8b
APERTUS_HOST=0.0.0.0
APERTUS_PORT=8000
APERTUS_CPU_THREADS=14
APERTUS_MAX_CONTEXT_TOKENS=8192
APERTUS_MAX_NEW_TOKENS=256
APERTUS_MAX_REQUEST_BYTES=262144
APERTUS_MODEL_CACHE_DIR=/models/huggingface/hub
# Hugging Face cache root is consumed by the publisher library.
HF_HOME=/models/huggingface
