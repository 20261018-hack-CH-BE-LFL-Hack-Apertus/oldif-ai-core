    {
      "agent": "researcher",
      "created_at": "2026-10-19T12:59:57.162860+00:00",
      "data": {
        "call_id": "chatcmpl-tool-8a6d4561a2ca9bcf",
        "result": {
          "id": "stapfer-2027",
          "licence": "https://opendata.swiss/de/terms-of-use#terms_open",
          "offset_unit": "unicode_scalar_value",
          "page": null,
          "passages": [
            {
              "char_end": 104,
              "char_start": 0,
              "passage_id": "p001",
              "text": "Alpthale eine eigene gemeinde ein kleines dörfchen von 10 häüsern im durchmesser eine grosse Stunde lang"
            },
            {
              "char_end": 161,
              "char_start": 107,
              "passage_id": "p002",
              "text": "eine kleine Stunde von dem ort gegen Schweiz 11 häüser"
            },
            {
              "char_end": 172,
              "char_start": 163,
              "passage_id": "p003",
              "text": "in brunni"
            },
            {
              "char_end": 218,
              "char_start": 174,
              "passage_id": "p004",
              "text": "gegen schweiz Einsidlen ein grosse 1/4 stund"
            },
            {
              "char_end": 228,
              "char_start": 220,
              "passage_id": "p005",
              "text": "9 haüser"
            },
            {
              "char_end": 313,
              "char_start": 230,
              "passage_id": "p006",
              "text": "im ganzen 30 haüser im kirchgang schweiz nun aber eigene begräbnis und taufzugehörr"
            },
            {
              "char_end": 345,
              "char_start": 315,
              "passage_id": "p007",
              "text": "eigene Municipalitat und agent"
            },
            {
              "char_end": 388,
              "char_start": 347,
              "passage_id": "p008",
              "text": "im kanton Waldstätten districkt Einsidlen"
            },
            {
              "char_end": 458,
              "char_start": 390,
              "passage_id": "p009",
              "text": "in diese bezirckes schuhle könten bej 40 kinder in die schule kommen"
            },
            {
              "char_end": 552,
              "char_start": 460,
              "passage_id": "p010",
              "text": "aber wegen schlechter ordnung seind 3 winter etwan 20 erschienen und das schlecht und selten"
            },
            {
              "char_end": 593,
              "char_start": 553,
              "passage_id": "p011",
              "text": "die nachste schuhle auf schweiz 3 stunde"
            },
            {
              "char_end": 652,
              "char_start": 595,
              "passage_id": "p012",
              "text": "die andern auf die Trachlauben ein Stunde oder 1/2 stunde"
            },
            {
              "char_end": 737,
              "char_start": 653,
              "passage_id": "p013",
              "text": "über die nächststehenden Fragen antworte ich im ganzen mit einem allgemeinen Bericht"
            },
            {
              "char_end": 856,
              "char_start": 739,
              "passage_id": "p014",
              "text": "||[Seite 2] die suhle Schule mus in diesem ort sehr schlecht gewesen sejn weil ich alda keine einzige persohn antrafe"
            },
            {
              "char_end": 935,
              "char_start": 858,
              "passage_id": "p015",
              "text": "welche recht lesen keine Schrift weder zu machen noch zu läsen im stande ware"
            },
            {
              "char_end": 940,
              "char_start": 937,
              "passage_id": "p016",
              "text": "N B"
            },
            {
              "char_end": 972,
              "char_start": 942,
              "passage_id": "p017",
              "text": "ich müste also fast alles sein"
            },
            {
              "char_end": 1024,
              "char_start": 974,
              "passage_id": "p018",
              "text": "wen das volk in der wirklichen Lage bestehen wolte"
            },
            {
              "char_end": 1074,
              "char_start": 1026,
              "passage_id": "p019",
              "text": "geistlich und weltliches zu besorgen lage mir ob"
            },
            {
              "char_end": 1101,
              "char_start": 1076,
              "passage_id": "p020",
              "text": "ich mache diese anmerkung"
            },
            {
              "char_end": 1160,
              "char_start": 1103,
              "passage_id": "p021",
              "text": "weil sie erlaubt und mir ohne grund Zur last gelegt wurde"
            },
            {
              "char_end": 1228,
              "char_start": 1162,
              "passage_id": "p022",
              "text": "ich frage mich aber vor jeder behörde gewissenhaft zu verantworten"
            },
            {
              "char_end": 1261,
              "char_start": 1230,
              "passage_id": "p023",
              "text": "der sich nicht verantworten kan"
            },
            {
              "char_end": 1306,
              "char_start": 1263,
              "passage_id": "p024",
              "text": "mag leicht angeklagt und beschuldigt werden"
            },
            {
              "char_end": 1351,
              "char_start": 1308,
              "passage_id": "p025",
              "text": "wer aber Man ist der darf wie ein Man reden"
            },
            {
              "char_end": 1435,
              "char_start": 1352,
              "passage_id": "p026",
              "text": "Hier in diesem ort ist kein schuhlhause und keine schuhl Stube und kein schuhlehrer"
            },
            {
              "char_end": 1451,
              "char_start": 1437,
              "passage_id": "p027",
              "text": "keine Stiftung"
            },
            {
              "char_end": 1477,
              "char_start": 1453,
              "passage_id": "p028",
              "text": "und keine gemeinds steür"
            },
            {
              "char_end": 1521,
              "char_start": 1478,
              "passage_id": "p029",
              "text": "Es wurde zwar jedem geistlichen aufgetragen"
            },
            {
              "char_end": 1600,
              "char_start": 1523,
              "passage_id": "p030",
              "text": "die schule zu halten da wurde von jedem kind für die wochen 1 baz versprochen"
            },
            {
              "char_end": 1700,
              "char_start": 1602,
              "passage_id": "p031",
              "text": "aber diese machte nicht lust schule zu halten in demme wenige kinder erscheinen und was erschienen"
            },
            {
              "char_end": 1715,
              "char_start": 1702,
              "passage_id": "p032",
              "text": "noch schlecht"
            },
            {
              "char_end": 1751,
              "char_start": 1717,
              "passage_id": "p033",
              "text": "und die bezahlung eben so schlecht"
            },
            {
              "char_end": 1779,
              "char_start": 1753,
              "passage_id": "p034",
              "text": "und mit zwang Einzutreiben"
            },
            {
              "char_end": 1923,
              "char_start": 1781,
              "passage_id": "p035",
              "text": "wurde nicht thunlich weil die Leüte arm und die kinder alle zusamen genommen zum allgemeinen besten ||[Seite 3] nicht für einen Bazen erlehret"
            },
            {
              "char_end": 1950,
              "char_start": 1924,
              "passage_id": "p036",
              "text": "ich hielte 2 winter schule"
            },
            {
              "char_end": 1967,
              "char_start": 1952,
              "passage_id": "p037",
              "text": "hatte 20 kinder"
            },
            {
              "char_end": 2007,
              "char_start": 1969,
              "passage_id": "p038",
              "text": "aber wie schon gemerket sehr unfleisig"
            },
            {
              "char_end": 2079,
              "char_start": 2009,
              "passage_id": "p039",
              "text": "ich dörfte 2 mädchen und ein knab stehlen die einigen Nuzen geschopfet"
            },
            {
              "char_end": 2138,
              "char_start": 2081,
              "passage_id": "p040",
              "text": "und dieses benimbt den Lust diese bemühung zu unternehmen"
            },
            {
              "char_end": 2190,
              "char_start": 2140,
              "passage_id": "p041",
              "text": "in deme die Pfarrverrrichtungen mit darzu obliegen"
            },
            {
              "char_end": 2235,
              "char_start": 2192,
              "passage_id": "p042",
              "text": "besonders die gewöhnliche fasten kinderlehr"
            },
            {
              "char_end": 2255,
              "char_start": 2236,
              "passage_id": "p043",
              "text": "dieses merke ich an"
            },
            {
              "char_end": 2300,
              "char_start": 2257,
              "passage_id": "p044",
              "text": "nicht das ich diese bemühung aufgeben wolle"
            },
            {
              "char_end": 2342,
              "char_start": 2302,
              "passage_id": "p045",
              "text": "aber weil ich ohnentgeltlich dieses thue"
            },
            {
              "char_end": 2374,
              "char_start": 2344,
              "passage_id": "p046",
              "text": "so nehme ich mir die fleisigen"
            },
            {
              "char_end": 2408,
              "char_start": 2376,
              "passage_id": "p047",
              "text": "und gelährigen und gehorsamen an"
            },
            {
              "char_end": 2473,
              "char_start": 2410,
              "passage_id": "p048",
              "text": "diese sollen im schreiben läsen und rechnen unterrichtet werden"
            },
            {
              "char_end": 2503,
              "char_start": 2475,
              "passage_id": "p049",
              "text": "gibt es noch dazwischen zeit"
            },
            {
              "char_end": 2590,
              "char_start": 2505,
              "passage_id": "p050",
              "text": "so werde ich trachten ihre vernunft mit wichtigen gegenstanden zu beschäftigen suchen"
            }
          ],
