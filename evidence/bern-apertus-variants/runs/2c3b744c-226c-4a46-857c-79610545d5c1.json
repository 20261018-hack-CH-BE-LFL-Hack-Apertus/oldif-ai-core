              "passage_id": "p032",
              "text": "noch schlecht"
            },
            {
              "char_end": 1751,
              "char_start": 1717,
              "passage_id": "p033",
              "text": "und die bezahlung eben so schlecht"
            },
            {
              "char_end": 1779,
              "char_start": 1753,
              "passage_id": "p034",
              "text": "und mit zwang Einzutreiben"
            },
            {
              "char_end": 1923,
              "char_start": 1781,
              "passage_id": "p035",
              "text": "wurde nicht thunlich weil die Leüte arm und die kinder alle zusamen genommen zum allgemeinen besten ||[Seite 3] nicht für einen Bazen erlehret"
            },
            {
              "char_end": 1950,
              "char_start": 1924,
              "passage_id": "p036",
              "text": "ich hielte 2 winter schule"
            },
            {
              "char_end": 1967,
              "char_start": 1952,
              "passage_id": "p037",
              "text": "hatte 20 kinder"
            },
            {
              "char_end": 2007,
              "char_start": 1969,
              "passage_id": "p038",
              "text": "aber wie schon gemerket sehr unfleisig"
            },
            {
              "char_end": 2079,
              "char_start": 2009,
              "passage_id": "p039",
              "text": "ich dörfte 2 mädchen und ein knab stehlen die einigen Nuzen geschopfet"
            },
            {
              "char_end": 2138,
              "char_start": 2081,
              "passage_id": "p040",
              "text": "und dieses benimbt den Lust diese bemühung zu unternehmen"
            },
            {
              "char_end": 2190,
              "char_start": 2140,
              "passage_id": "p041",
              "text": "in deme die Pfarrverrrichtungen mit darzu obliegen"
            },
            {
              "char_end": 2235,
              "char_start": 2192,
              "passage_id": "p042",
              "text": "besonders die gewöhnliche fasten kinderlehr"
            },
            {
              "char_end": 2255,
              "char_start": 2236,
              "passage_id": "p043",
              "text": "dieses merke ich an"
            },
            {
              "char_end": 2300,
              "char_start": 2257,
              "passage_id": "p044",
              "text": "nicht das ich diese bemühung aufgeben wolle"
            },
            {
              "char_end": 2342,
              "char_start": 2302,
              "passage_id": "p045",
              "text": "aber weil ich ohnentgeltlich dieses thue"
            },
            {
              "char_end": 2374,
              "char_start": 2344,
              "passage_id": "p046",
              "text": "so nehme ich mir die fleisigen"
            },
            {
              "char_end": 2408,
              "char_start": 2376,
              "passage_id": "p047",
              "text": "und gelährigen und gehorsamen an"
            },
            {
              "char_end": 2473,
              "char_start": 2410,
              "passage_id": "p048",
              "text": "diese sollen im schreiben läsen und rechnen unterrichtet werden"
            },
            {
              "char_end": 2503,
              "char_start": 2475,
              "passage_id": "p049",
              "text": "gibt es noch dazwischen zeit"
            },
            {
              "char_end": 2590,
              "char_start": 2505,
              "passage_id": "p050",
              "text": "so werde ich trachten ihre vernunft mit wichtigen gegenstanden zu beschäftigen suchen"
            }
          ],
