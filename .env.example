AI_HTTP_BIND=0.0.0.0:8082
AI_GRPC_BIND=0.0.0.0:50052
INTERNAL_SERVICE_TOKEN=replace-with-random-32-character-token
CSCS_BASE_URL=https://api.inference.cscs.ch/v1
CSCS_API_KEY=replace-with-cscs-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-openai-key
AI_DEFAULT_MODEL=apertus-v1-5-8b
AI_REFERENCE_MODEL=gpt-6-astra
AI_REALTIME_MODEL=gpt-realtime-2.1
AI_TRANSCRIPTION_MODEL=gpt-live-transcribe
AI_VOICE=marin
AI_VOICE_ENABLED=false
AI_RUN_DIR=./data/runs
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_SOURCES=30
AI_MAX_INPUT_BYTES=120000
AI_MAX_TOOL_CALLS=4
AI_MAX_CONCURRENCY=2
AI_MAX_RUNS=1000
AI_IMAGE_TAG=dev
AI_HTTP_PORT=8082
AI_GRPC_PORT=50052

# Optional local CPU diarization; immutable artifacts are included by the Dockerfile.
AI_DIARIZATION_BIN=/opt/nemo/bin/nemo-speech
AI_DIARIZATION_MODEL=/opt/nemo/model.gguf
